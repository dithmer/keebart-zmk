#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE 0
#define LOWER 1
#define RAISE 2
#define ADJUST 3

/ {
    // Activate ADJUST layer by pressing raise and lower

    conditional_layers {
        compatible = "zmk,conditional-layers";

        adjust_layer {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };

    behaviors {
        lhm: lhm {
            compatible = "zmk,behavior-hold-tap";
            label = "LHM";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <350>;
            quick-tap-ms = <300>;
            require-prior-idle-ms = <180>;
            flavor = "tap-preferred";
            hold-trigger-on-release;
            hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 44 45 46 47 48 49 55 56 57 58 59 43>;
        };

        rhm: rhm {
            compatible = "zmk,behavior-hold-tap";
            label = "RHM";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <350>;
            quick-tap-ms = <300>;
            require-prior-idle-ms = <180>;
            flavor = "tap-preferred";
            hold-trigger-on-release;
            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38 39 40 41 42 50 51 52 53 54>;
        };

        longpress: longpress {
            compatible = "zmk,behavior-hold-tap";
            label = "LONGPRESS";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <500>;
            require-prior-idle-ms = <150>;
            quick-tap-ms = <175>;
        };
    };

    combos {
        compatible = "zmk,combos";

        mouselayer {
            bindings = <&mo 3>;
            key-positions = <16 15 14>;
            layers = <0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "default";

            // ------------------------------------------------------------------------------------------------------------
            // |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |   `   |
            // |  ESC  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   | BKSPC |
            // |  TAB  |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |  MUTE  |  | PLAY  |  N   |  M    |  ,    |  .   |   /   | SHIFT |
            //               | GUI | ALT  | CTRL | LOWER|  ENTER |  | SPACE | RAISE| CTRL  | ALT   | GUI  |

            bindings = <
&kp GRAVE   &kp N1  &kp N2  &kp N3           &kp N4        &kp N5                                                  &kp N6  &kp N7        &kp N8            &kp N9   &kp N0    &kp GRAVE
&kp TAB     &kp Q   &kp W   &kp E            &kp R         &kp T   &kp Y                                                   &kp U         &kp I             &kp O    &kp P     &kp BSPC
&kp INSERT  &kp A   &kp S   &lhm LEFT_ALT D  &lhm LSHFT F  &kp G   &kp H                                                   &rhm RSHFT J  &rhm RIGHT_ALT K  &kp L    &kp SEMI  &kp SQT
&kp DELETE  &kp Z   &kp X   &kp C            &kp V         &kp B   &kp C_MUTE              &kp C_PLAY              &kp N   &kp M         &kp COMMA         &kp DOT  &kp FSLH  &kp ESCAPE
                    &to 4   &none            &kp LEFT_GUI  &mo 1   &longpress LCTRL SPACE  &longpress RCTRL ENTER  &sl 2   &kp RGUI      &none             &none
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp C_PREV C_NEXT>;
        };

        lower_layer {
            display-name = "lower";

            // ------------------------------------------------------------------------------------------------------------
            // |       |  F1 |  F2 |  F3  |  F4  |  F5  |                   |  F6  |  F7   |  F8   |  F9  |  F10  |  F11  |
            // |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |  F12  |
            // |       |  !  |  @  |  #   |  $   |  %   |                   |  ^   |  &    |  *    |  (   |   )   |   |   |
            // |       |  =  |  -  |  +   |  {   |  }   |        |  |       |  [   |  ]    |  ;    |  :   |   \   |       |
            //               |     |      |      |      |        |  |       |      |       |       |      |

            bindings = <
&trans  &trans        &trans          &trans           &trans       &trans                         &trans        &trans        &trans        &trans        &trans  &trans
&trans  &trans        &trans          &kp UP_ARROW     &trans       &trans         &trans                        &kp N7        &kp N8        &kp N9        &trans  &trans
&trans  &kp LS(LEFT)  &kp LEFT_ARROW  &kp DOWN         &kp RIGHT    &kp LS(RIGHT)  &trans                        &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &trans  &trans
&trans  &trans        &kp PAGE_DOWN   &kp PRINTSCREEN  &kp PAGE_UP  &trans         &trans  &trans  &trans        &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &trans  &trans
                      &trans          &trans           &trans       &trans         &trans  &trans  &kp NUMBER_0  &trans        &trans        &trans
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_DN C_VOL_UP>,
                <&inc_dec_kp LC(PAGE_UP) LC(PAGE_DOWN)>;
        };

        raise_layer {
            display-name = "raise";

            // ------------------------------------------------------------------------------------------------------------
            // | BTCLR | BT1  | BT2  |  BT3  |  BT4  |  BT5 |                |      |      |       |      |       |       |
            // |       | INS  | PSCR | GUI   |       |      |                | PGUP |      |   ^   |      |       |       |
            // |       | ALT  | CTRL | SHIFT |       | CAPS |                | PGDN |   <- |   v   |  ->  |  DEL  | BKSPC |
            // |       | UNDO | CUT  | COPY  | PASTE |      |      |  |      |      |      |       |      |       |       |
            //                |      |       |       |      |      |  |      |      |      |       |      |

            bindings = <
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1   &bt BT_SEL 2      &bt BT_SEL 3  &bt BT_SEL 4                      &trans    &trans          &trans            &trans             &trans         &trans
&trans      &kp LS(EXCL)  &kp LS(AT)     &kp HASH          &kp LS(DLLR)  &kp LS(PRCNT)  &kp CARET                    &kp LS(AMPS)    &kp LS(LPAR)      &kp LS(RPAR)       &kp ASTRK      &trans
&kp TILDE   &kp EQUAL     &kp LESS_THAN  &kp GREATER_THAN  &kp MINUS     &kp HASH       &kp EQUAL                    &kp MINUS       &kp LEFT_BRACE    &kp RIGHT_BRACE    &kp PIPE       &trans
&trans      &trans        &trans         &trans            &trans        &trans         &trans     &trans  &kp PLUS  &kp UNDERSCORE  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp BACKSLASH  &trans
                          &trans         &trans            &trans        &trans         &trans     &trans  &trans    &trans          &trans            &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp C_PREV C_NEXT>;
        };

        test {
            bindings = <
&trans       &trans  &trans  &trans  &trans  &trans                             &trans  &trans          &trans        &trans           &trans  &trans
&trans       &trans  &trans  &trans  &trans  &trans  &trans                             &trans          &trans        &trans           &trans  &trans
&bootloader  &trans  &trans  &trans  &trans  &trans  &mmv MOVE_LEFT                     &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT  &trans  &bootloader
&trans       &trans  &trans  &trans  &trans  &trans  &trans          &trans     &trans  &trans          &trans        &trans           &trans  &trans
                     &trans  &trans  &trans  &trans  &mkp LCLK       &mkp RCLK  &trans  &trans          &trans        &trans
            >;

            label = "test";
        };

        gaming {
            bindings = <
&kp ESC    &kp N1  &kp N2  &kp N3  &kp N4    &kp N5                      &kp N6  &kp N7  &kp N8     &kp N9   &kp N0    &trans
&kp TAB    &kp Q   &kp W   &kp E   &kp R     &kp T   &kp Y                       &kp U   &kp I      &kp O    &kp P     &trans
&kp LSHFT  &kp A   &kp S   &kp D   &kp F     &kp G   &kp H                       &kp J   &kp K      &kp L    &kp SEMI  &kp SQT
&kp LCTRL  &kp Z   &kp X   &kp C   &kp V     &kp B   &trans     &trans   &kp N   &kp M   &kp COMMA  &kp DOT  &kp FSLH  &trans
                   &to 0   &trans  &kp LGUI  &mo 5   &kp SPACE  &kp RET  &trans  &trans  &trans     &trans
            >;
        };

        gaming_raise {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                   &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp F1  &kp F2  &kp F3  &kp F4  &kp F5   &trans                  &trans  &trans  &trans  &trans  &trans
&trans  &kp F6  &kp F7  &kp F8  &kp F9  &kp F10  &trans                  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans   &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans   &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
